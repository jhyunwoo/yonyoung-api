{
	"name": "yonyoung-api",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "pnpm run db:migrate:local && wrangler dev --env dev",
		"deploy": "wrangler deploy --minify",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"lint": "eslint src --max-warnings 0",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply yonyoung-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply yonyoung-db --remote",
		"db:studio": "drizzle-kit studio",
		"check-types": "pnpm run typecheck",
		"test:node": "vitest run",
		"test:workers": "vitest run -c vitest.workers.config.ts",
		"test": "pnpm run test:node && pnpm run test:workers",
		"test:integration": "vitest run src/tests/worker.runtime.integration.test.ts",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1048.0",
		"@aws-sdk/s3-request-presigner": "^3.1048.0",
		"@hono/zod-openapi": "^1.4.0",
		"@scalar/hono-api-reference": "^0.9.48",
		"better-auth": "^1.6.11",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.18",
		"web-push": "^3.6.7",
		"xss": "^1.0.15",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.10.15",
		"@eslint/js": "^10.0.1",
		"@types/node": "^25.8.0",
		"@types/web-push": "^3.6.4",
		"@vitest/coverage-v8": "^3.2.4",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9.39.4",
		"typescript-eslint": "^8.59.3",
		"vitest": "^3.2.4",
		"wrangler": "^4.92.0"
	}
}
