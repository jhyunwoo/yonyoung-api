{
	"name": "yonyoung-api",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy --minify",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"lint": "eslint src --max-warnings 0",
		"typecheck": "tsc --noEmit",
		"check-types": "pnpm run typecheck",
		"test:node": "vitest run",
		"test:workers": "vitest run -c vitest.workers.config.ts",
		"test": "pnpm run test:node && pnpm run test:workers",
		"test:integration": "vitest run src/tests/worker.runtime.integration.test.ts",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1000.0",
		"@aws-sdk/s3-request-presigner": "^3.1000.0",
		"@hono/zod-openapi": "^1.2.2",
		"@scalar/hono-api-reference": "^0.9.46",
		"better-auth": "^1.4.20",
		"dotenv": "^17.3.1",
		"drizzle-orm": "^0.45.1",
		"hono": "^4.12.3",
		"web-push": "^3.6.7",
		"xss": "^1.0.15",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.10.8",
		"@eslint/js": "^10.0.1",
		"@types/node": "^25.3.2",
		"@types/web-push": "^3.6.4",
		"@vitest/coverage-v8": "^3.2.4",
		"drizzle-kit": "^0.31.9",
		"eslint": "^9.39.3",
		"typescript-eslint": "^8.56.1",
		"vitest": "^3.2.4",
		"wrangler": "^4.69.0"
	}
}
