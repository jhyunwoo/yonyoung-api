{
	"name": "yonyoung-api",
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"dev": "pnpm run db:migrate:local && wrangler dev --env dev",
		"deploy": "wrangler deploy --env=\"\" --minify",
		"deploy:dry-run": "wrangler deploy --env=\"\" --dry-run --outdir .wrangler/dry-run",
		"cf-typegen": "wrangler types --env-interface CloudflareBindings",
		"lint": "eslint src --max-warnings 0",
		"typecheck": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply yonyoung-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply yonyoung-db --remote",
		"db:studio": "drizzle-kit studio",
		"backfill:image-dimensions": "node scripts/backfill-image-dimensions.mjs",
		"check-types": "pnpm run typecheck",
		"test:node": "vitest run",
		"test:workers": "vitest run -c vitest.workers.config.ts",
		"test": "pnpm run test:node && pnpm run test:workers",
		"test:integration": "vitest run src/tests/worker.runtime.integration.test.ts",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"security:audit": "pnpm audit --prod --audit-level critical"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1085.0",
		"@aws-sdk/s3-request-presigner": "^3.1085.0",
		"@hono/zod-openapi": "^1.4.0",
		"@scalar/hono-api-reference": "^0.9.48",
		"better-auth": "^1.6.23",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.29",
		"xss": "^1.0.15",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.10.15",
		"@eslint/js": "^10.0.1",
		"@types/node": "^25.9.5",
		"@vitest/coverage-v8": "^3.2.7",
		"drizzle-kit": "^0.31.10",
		"eslint": "^9.39.5",
		"typescript": "6.0.2",
		"typescript-eslint": "^8.63.0",
		"vitest": "^3.2.7",
		"wrangler": "^4.110.0"
	}
}
