/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yonyoung-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-27",
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "r2_buckets": [
    {
      "bucket_name": "yonyoung-storage",
      "binding": "r2",
      "remote": false
    }
  ],
  "d1_databases": [
    {
      "binding": "db",
      "database_name": "yonyoung-db",
      "database_id": "2b8373ca-0dd5-486f-aa2f-4847e5e2b79a",
      "migrations_dir": "drizzle",
      "remote": false
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "PERF_ANALYTICS",
      "dataset": "yonyoung_api_perf"
    }
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://yonyoung.yonsei.ac.kr",
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://yonyoung.yonsei.ac.kr,https://dev.yonyoung.moveto.kr",
    "R2_PUBLIC_BASE_URL": "https://storage.yonyoung.moveto.kr",
    "R2_BUCKET": "yonyoung-storage",
    "VAPID_PUBLIC_KEY": "E0QyEop1GC5FZG7Waq6W3lh23kKZatbFPDNYaTahJjo",
    "VAPID_SUBJECT": "mailto:support@moveto.kr",
    "DOCS_ENABLED": "false",
    "CSP_REPORT_ONLY": "false",
    "D1_SESSION_CONSISTENCY": "off",
    "D1_WRITE_RETRY_ENABLED": "true",
    "D1_WRITE_RETRY_MAX_RETRIES": "2",
    "D1_WRITE_RETRY_BASE_DELAY_MS": "25",
    "D1_WRITE_RETRY_MAX_DELAY_MS": "500",
    "PERF_ANALYTICS_ENABLED": "false",
    "PERF_ANALYTICS_SAMPLE_RATE": "0.2"
  },
  "env": {
    "dev": {
      "vars": {
        "BETTER_AUTH_URL": "https://yonyoung.yonsei.ac.kr",
        "BETTER_AUTH_TRUSTED_ORIGINS": "https://yonyoung.yonsei.ac.kr,https://dev.yonyoung.moveto.kr",
        "R2_PUBLIC_BASE_URL": "https://storage.yonyoung.moveto.kr",
        "R2_BUCKET": "yonyoung-storage",
        "VAPID_PUBLIC_KEY": "E0QyEop1GC5FZG7Waq6W3lh23kKZatbFPDNYaTahJjo",
        "VAPID_SUBJECT": "mailto:support@moveto.kr",
        "DOCS_ENABLED": "true",
        "CSP_REPORT_ONLY": "false",
        "D1_SESSION_CONSISTENCY": "off",
        "D1_WRITE_RETRY_ENABLED": "true",
        "D1_WRITE_RETRY_MAX_RETRIES": "2",
        "D1_WRITE_RETRY_BASE_DELAY_MS": "25",
        "D1_WRITE_RETRY_MAX_DELAY_MS": "500",
        "PERF_ANALYTICS_ENABLED": "false",
        "PERF_ANALYTICS_SAMPLE_RATE": "0.2"
      },
      "r2_buckets": [
        {
          "bucket_name": "yonyoung-storage",
          "binding": "r2",
          "remote": false
        }
      ],
      "d1_databases": [
        {
          "binding": "db",
          "database_name": "yonyoung-db",
          "database_id": "2b8373ca-0dd5-486f-aa2f-4847e5e2b79a",
          "migrations_dir": "drizzle",
          "remote": false,
        },
      ],
      "analytics_engine_datasets": [
        {
          "binding": "PERF_ANALYTICS",
          "dataset": "yonyoung_api_perf"
        }
      ]
    }
  }
  /**
   * Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": {  "mode": "smart" }
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  // "vars": {  "MY_VARIABLE": "production_value" }
  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
