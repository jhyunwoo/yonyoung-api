/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yonyoung-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
  },
  "observability": {
    "enabled": true,
  },
  "placement": {
    "mode": "smart",
  },
  "exports": {
    "PublicApi": {
      "type": "worker",
      "cache": {
        "enabled": true,
      },
    },
  },
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [
    {
      "bucket_name": "yonyoung-storage",
      "binding": "r2",
      "remote": false,
    },
  ],
  "kv_namespaces": [
    {
      "binding": "PUBLIC_API_CACHE",
      "id": "b975be0e5565495ebe38ec5c3d458627",
      "remote": false,
    },
  ],
  "d1_databases": [
    {
      "binding": "db",
      "database_name": "yonyoung-db",
      "database_id": "2b8373ca-0dd5-486f-aa2f-4847e5e2b79a",
      "migrations_dir": "drizzle",
      "remote": false,
    },
  ],
  "analytics_engine_datasets": [
    {
      "binding": "PERF_ANALYTICS",
      "dataset": "yonyoung_api_perf",
    },
  ],
  "ratelimits": [
    {
      "name": "PAGE_VIEW_RATE_LIMITER",
      "namespace_id": "817941615",
      "simple": {
        "limit": 30,
        "period": 60,
      },
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://yonyoung.yonsei.ac.kr",
    "BETTER_AUTH_TRUSTED_ORIGINS": "https://yonyoung.yonsei.ac.kr",
    "R2_PUBLIC_BASE_URL": "https://storage.yonyoung.moveto.kr",
    "R2_BUCKET": "yonyoung-storage",
    "DOCS_ENABLED": "false",
    "CSP_REPORT_ONLY": "false",
    "D1_SESSION_CONSISTENCY": "off",
    "D1_WRITE_RETRY_ENABLED": "true",
    "D1_WRITE_RETRY_MAX_RETRIES": "2",
    "D1_WRITE_RETRY_BASE_DELAY_MS": "25",
    "D1_WRITE_RETRY_MAX_DELAY_MS": "500",
    "PERF_ANALYTICS_ENABLED": "false",
    "PERF_ANALYTICS_SAMPLE_RATE": "0.2",
  },
  "env": {
    "dev": {
      "vars": {
        "BETTER_AUTH_URL": "https://yonyoung.yonsei.ac.kr",
        "BETTER_AUTH_TRUSTED_ORIGINS": "https://yonyoung.yonsei.ac.kr,https://dev.yonyoung.moveto.kr",
        "R2_PUBLIC_BASE_URL": "https://storage.yonyoung.moveto.kr",
        "R2_BUCKET": "yonyoung-storage",
        "DOCS_ENABLED": "true",
        "CSP_REPORT_ONLY": "false",
        "D1_SESSION_CONSISTENCY": "off",
        "D1_WRITE_RETRY_ENABLED": "true",
        "D1_WRITE_RETRY_MAX_RETRIES": "2",
        "D1_WRITE_RETRY_BASE_DELAY_MS": "25",
        "D1_WRITE_RETRY_MAX_DELAY_MS": "500",
        "PERF_ANALYTICS_ENABLED": "false",
        "PERF_ANALYTICS_SAMPLE_RATE": "0.2",
      },
      "r2_buckets": [
        {
          "bucket_name": "yonyoung-storage",
          "binding": "r2",
          "remote": false,
        },
      ],
      "kv_namespaces": [
        {
          "binding": "PUBLIC_API_CACHE",
          "id": "5e57237224804e508a7af41ddc780fdf",
          "remote": false,
        },
      ],
      "d1_databases": [
        {
          "binding": "db",
          "database_name": "yonyoung-db",
          "database_id": "2b8373ca-0dd5-486f-aa2f-4847e5e2b79a",
          "migrations_dir": "drizzle",
          "remote": false,
        },
      ],
      "analytics_engine_datasets": [
        {
          "binding": "PERF_ANALYTICS",
          "dataset": "yonyoung_api_perf",
        },
      ],
      "ratelimits": [
        {
          "name": "PAGE_VIEW_RATE_LIMITER",
          "namespace_id": "817941616",
          "simple": {
            "limit": 30,
            "period": 60,
          },
        },
      ],
    },
  },
  /**
   * Smart Placement
   * https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  // "placement": {  "mode": "smart" }
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  // "vars": {  "MY_VARIABLE": "production_value" }
  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [  {   "binding": "MY_SERVICE",   "service": "my-service"  } ]
}
