    "GET /api/users/{id}/resource-history": {
      "operationId": "getUserResourceHistory",
      "parameters": [
        {
          "description": "사용자 식별자 (better-auth user.id)",
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "description": "사용자 식별자 (better-auth user.id)",
            "example": "OrYuGkpIFldOIkcrxLrwgzEegsLSJbrh",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "type": "string",
          },
        },
        {
          "description": "조회할 페이지 번호(기본 1)",
          "in": "query",
          "name": "page",
          "required": false,
          "schema": {
            "default": 1,
            "description": "조회할 페이지 번호(기본 1)",
            "example": 1,
            "minimum": 1,
            "type": "integer",
          },
        },
        {
          "description": "페이지당 조회할 최대 이력 수(기본 10, 최대 100)",
          "in": "query",
          "name": "pageSize",
          "required": false,
          "schema": {
            "default": 10,
            "description": "페이지당 조회할 최대 이력 수(기본 10, 최대 100)",
            "example": 10,
            "maximum": 100,
            "minimum": 1,
            "type": "integer",
          },
        },
