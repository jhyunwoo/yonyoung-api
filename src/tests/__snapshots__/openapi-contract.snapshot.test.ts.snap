                    "items": {
                      "properties": {
                        "latencyMs": {
                          "type": "number",
                        },
                        "service": {
                          "enum": [
                            "d1",
                            "view_counts",
                            "r2",
                            "r2_presign",
                            "durable_object",
                            "assets",
                            "service_binding",
                          ],
                          "type": "string",
                        },
                        "status": {
                          "enum": [
                            "healthy",
                            "unhealthy",
                            "skipped",
                          ],
                          "type": "string",
                        },
