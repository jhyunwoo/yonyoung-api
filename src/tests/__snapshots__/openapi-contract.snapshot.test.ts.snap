                "required": [
                  "data",
                ],
                "type": "object",
              },
            },
          },
          "description": "Presigned URL 발급 성공",
        },
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ApiErrorResponse",
